# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.
PORT=5000

# Option 1 (simplest): MongoDB installed on your own computer
MONGO_URI=mongodb://127.0.0.1:27017/hotel
# Option 2: MongoDB Atlas (cloud). Use the connection string Atlas gives you:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hotel?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string

# Secret code needed to sign up as an admin. Only the hotel owner should know it.
ADMIN_CODE=change_this_admin_code
